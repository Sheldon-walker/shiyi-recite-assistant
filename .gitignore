# ==========================================================
# 拾忆 · 艾宾浩斯背诵助手 —— Git 忽略规则
# 原则：只提交源码、资源与文档；用户数据、密钥、构建产物一律不入库。
# ==========================================================

# ---------- 1. 用户数据与密钥（最高优先级，绝不能提交） ----------
# review_data.json 里包含 API Key（settings.ai.apiKey）和全部背诵内容。
review_data.json
review_data.json.tmp
review_data.corrupt-*.json
dist/review_data.json
dist/review_data.json.tmp
dist/review_data.corrupt-*.json

# 环境变量 / 本地密钥配置
.env
.env.*
!.env.example
*.env
*.pem
*.key
secrets.json
config.local.*
*_local.py

# 调试自测输出（可能包含运行信息）
selftest_result.json

# ---------- 2. 打包产物与构建缓存 ----------
dist/
build/
*.spec
*.exe
*.msi
*.dmg
*.app
*.lnk
# PyInstaller onefile 运行残留
_MEI*/
*.pkg

# ---------- 3. Python 缓存与虚拟环境 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
virtualenv/
pip-wheel-metadata/
*.egg-info/
.eggs/

# ---------- 4. 日志与临时文件 ----------
*.log
logs/
.tmp/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ---------- 5. 测试 / 覆盖率产物 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ---------- 6. 编辑器 / IDE ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---------- 7. 操作系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/

# ---------- 8. 本项目工作区元数据 ----------
# WorkBuddy 会话记忆与中间产物不属于交付内容
.workbuddy/
